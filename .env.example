# mcp-guardian settings (GUARDIAN_ prefix)
GUARDIAN_HOST=0.0.0.0
GUARDIAN_PORT=9000
GUARDIAN_CONFIG_PATH=scope.yaml
GUARDIAN_SCOPE=support-agent
GUARDIAN_LOG_LEVEL=INFO

# PostgreSQL MCP server URL (not the database itself)
POSTGRES_MCP_URL=http://localhost:3000/mcp

# Database connection string (used by postgres-mcp docker, not the proxy)
POSTGRES_URL=postgresql://user:pass@host:5432/dbname
